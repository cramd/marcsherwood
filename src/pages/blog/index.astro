---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...archive] = posts;
---

<BaseLayout title="Writing | Marc Sherwood" description="Essays on commercial open source, go-to-market strategy, applied AI, systems thinking, and the things Marc Sherwood can't stop thinking about." mainClass="flex-grow w-full">
  <section class="bg-slate-900 text-white border-b border-slate-700">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8">
        <p class="text-sm font-mono text-blue-300 uppercase tracking-wider mb-4">Writing · Marc Sherwood</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-tight mb-6">Things I can't stop<br /><span class="text-blue-300">thinking about.</span></h1>
        <p class="text-xl text-slate-200 leading-relaxed max-w-3xl">Essays on commercial open source, technology, AI, systems and the gap between what we think is happening and what actually happens.</p>
      </div>
      <aside class="lg:col-span-4 border-l-2 border-blue-400 pl-6 py-2">
        <p class="text-sm font-mono text-blue-300 uppercase tracking-wider mb-3">A fair warning</p>
        <p class="text-slate-200 leading-relaxed">What I am paid to know and what I am curious about don't always line up. Sometimes you'll get expertise. Sometimes you'll get enthusiastic amateur hour. I'll try to tell you which is which.</p>
      </aside>
    </div>
  </section>

  {featured && (
    <section class="max-w-6xl mx-auto px-6 py-14 md:py-20">
      <p class="text-sm font-mono text-blue-700 uppercase tracking-wider mb-4">Latest essay</p>
      <a href={`/blog/${featured.id}/`} class="group block glass-panel rounded-2xl overflow-hidden border border-slate-200 hover:border-blue-300 transition-colors">
        <div class={featured.data.heroImage ? 'grid md:grid-cols-2' : 'bg-white'}>
          {featured.data.heroImage && (
            <div class="min-h-64 bg-slate-900">
              <Image width={960} height={540} src={featured.data.heroImage} alt="" class="w-full h-full object-cover" />
            </div>
          )}
          <div class="p-8 md:p-12 flex flex-col justify-center">
            <p class="font-mono text-sm text-slate-500 mb-4"><FormattedDate date={featured.data.pubDate} /></p>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 group-hover:text-blue-700 transition-colors mb-4">{featured.data.title}</h2>
            <p class="text-lg leading-relaxed text-slate-600 mb-6">{featured.data.description}</p>
            <span class="font-semibold text-blue-700">Read the essay</span>
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="bg-white border-y border-slate-200">
    <div class="max-w-6xl mx-auto px-6 py-14 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <p class="text-sm font-mono text-blue-700 uppercase tracking-wider mb-3">The archive</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">More things worth exploring.</h2>
        </div>
        <span class="text-sm font-medium text-slate-500">{archive.length} {archive.length === 1 ? 'essay' : 'essays'}</span>
      </div>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {archive.map((post) => (
          <li class="h-full">
            <a href={`/blog/${post.id}/`} class="group h-full flex flex-col glass-panel rounded-2xl border border-slate-200 overflow-hidden hover:border-blue-300 transition-colors">
              {post.data.heroImage && (
                <div class="bg-slate-100 h-48 overflow-hidden">
                  <Image width={720} height={400} src={post.data.heroImage} alt="" class="w-full h-full object-cover" />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <p class="text-sm font-mono text-slate-500 mb-3"><FormattedDate date={post.data.pubDate} /></p>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-700 transition-colors mb-3">{post.data.title}</h3>
                <p class="text-slate-600 leading-relaxed flex-grow mb-5">{post.data.description}</p>
                <span class="font-semibold text-blue-700">Read essay</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-6 py-14 md:py-16 grid md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-8">
        <p class="text-sm font-mono text-blue-300 uppercase tracking-wider mb-3">Beyond the writing</p>
        <h2 class="text-3xl font-bold tracking-tight mb-4">I don't just write about these problems.</h2>
        <p class="text-lg leading-relaxed text-slate-300">My professional work brings together technical strategy, customer-led positioning and applied software development. Explore what I build and how I work with teams.</p>
      </div>
      <div class="md:col-span-4 flex flex-col gap-3">
        <a href="/cv" class="px-6 py-3 text-center bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition-colors">CV & projects</a>
        <a href="/gtm" class="px-6 py-3 text-center border border-slate-500 hover:border-blue-300 text-white font-semibold rounded-lg transition-colors">Fractional GTM</a>
      </div>
    </div>
  </section>
</BaseLayout>
