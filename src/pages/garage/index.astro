---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const garageEntries = (await getCollection('garage')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="The Garage | Marc Sherwood" description="Motorcycles, Jeeps, restoration projects, ride logs and the stories behind them.">
	<section class="mb-12 animate-fade-in">
		<p class="font-mono text-sm text-orange-700 uppercase tracking-wider mb-3">Marc Sherwood · Beyond the day job</p>
		<h1 class="text-5xl font-bold mb-4 tracking-tight text-slate-900">The Garage.</h1>
		<p class="text-slate-600 text-lg max-w-2xl">A collection of machines, stories, builds and adventures. Some are finding a new home; others are just getting started.</p>
	</section>
	<section class="mb-14">
		<a href="/ktm300/" class="block rounded-2xl bg-slate-900 text-white overflow-hidden border border-orange-500 mb-6">
			<div class="grid md:grid-cols-2"><div class="bg-orange-600 flex flex-col items-center justify-center p-10"><span class="text-sm font-mono uppercase tracking-widest">2025 · XC-W</span><span class="text-8xl font-black tracking-tighter">300</span></div><div class="p-8"><p class="font-mono text-sm text-orange-300 mb-3">Newest addition · Enduro</p><h2 class="text-3xl font-bold mb-3">Back to the woods.</h2><p class="text-slate-300 mb-5">The 2025 KTM 300 XC-W starts the next chapter of my riding life.</p><span class="font-semibold text-orange-300">Meet the new KTM</span></div></div>
		</a>
		<div class="grid sm:grid-cols-2 gap-5">
			{[
				{href:'/rm250/',img:'/assets/rm250/rm250-hero.jpg',name:'2008 Suzuki RM250',tag:'Race-built · Final-year two-stroke',body:'A proper motocross two-stroke, upgraded hardware and a collection of spares.'},
				{href:'/rm125/',img:'/assets/rm125/finished-side.jpg',name:'2007 Suzuki RM125',tag:'Suzanne · Frame-up rebuild',body:'A little Suzuki with a name and a second chapter.'},
				{href:'/f800gs/',img:'/assets/f800gs/hero-lake.jpg',name:'2013 BMW F800GS',tag:'Adventure · Touring',body:'My well-equipped adventure bike and its story.'},
				{href:'/thriftyjeep/',img:'/assets/thriftyjeep/wheel-placement.jpg',name:'2013 Jeep Wrangler JK',tag:'Operation Thrifty Jeep',body:'Build the driver. Build the Jeep. Earn every upgrade.'}
			].map(v=><a href={v.href} class="block rounded-xl overflow-hidden bg-white border border-slate-200 hover:border-orange-400"><img src={v.img} alt={v.name} class="w-full aspect-video object-cover" loading="lazy"/><div class="p-5"><p class="font-mono text-xs text-orange-700 mb-2">{v.tag}</p><h2 class="text-xl font-bold mb-2">{v.name}</h2><p class="text-slate-600">{v.body}</p></div></a>)}
		</div>
		<a href="https://sebring.marcsherwood.com" class="mt-6 block border border-slate-200 bg-white rounded-xl p-6 hover:border-orange-400"><p class="font-mono text-sm text-orange-700 mb-2">Restoration with Dad</p><h2 class="text-xl font-bold">1965 Ducati Sebring 350</h2><p class="text-slate-600 mt-2">Explore the dedicated restoration project.</p></a>
	</section>

	<section class="animate-fade-in" style="animation-delay: 0.1s;">
		<h2 class="text-2xl font-bold mb-5">Workshop & ride logs</h2>
		<div class="space-y-6">
			{
				garageEntries.map((entry) => (
					<a href={`/garage/${entry.id}/`} class="block glass-panel p-6 rounded-xl hover:border-orange-300 transition-colors group">
						<div class="flex justify-between items-start mb-2">
							<div>
								<h2 class="text-2xl font-bold text-slate-900 group-hover:text-orange-600 transition-colors">{entry.data.title}</h2>
								<span class="text-sm font-mono text-orange-600">{entry.data.bikeModel}</span>
							</div>
							<div class="flex flex-col items-end">
								<span class="px-2.5 py-1 text-xs font-medium bg-orange-50 border border-orange-200 rounded-md text-orange-800 mb-2">{entry.data.type}</span>
								<span class="text-xs font-mono text-slate-500"><FormattedDate date={entry.data.date} /></span>
							</div>
						</div>
						{entry.data.description && (
							<p class="text-slate-600 mt-2">{entry.data.description}</p>
						)}
					</a>
				))
			}

			{garageEntries.length === 0 && (
				<div class="p-8 text-center glass-panel rounded-xl">
					<p class="text-slate-600">No workshop logs yet. Time to go for a ride!</p>
				</div>
			)}
		</div>
	</section>
</BaseLayout>
