---
import { type CollectionEntry, getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('garage');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'garage'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Garage`} description={post.data.description || 'Garage Log'}>
	<article class="glass-panel p-8 rounded-2xl">
		<div class="mb-8 border-b border-slate-200 pb-8">
			<div class="flex items-center gap-3 mb-4">
				<span class="px-3 py-1 text-sm font-medium bg-orange-50 text-orange-800 border border-orange-200 rounded-md">{post.data.type}</span>
				<span class="text-slate-500 font-mono text-sm"><FormattedDate date={post.data.date} /></span>
			</div>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 mb-2">{post.data.title}</h1>
			<p class="text-xl text-orange-600 font-mono">{post.data.bikeModel}</p>
		</div>

		<div class="markdown-prose">
			<Content />
		</div>
	</article>
</BaseLayout>
