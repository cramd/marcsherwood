---
import BaseHead from '../components/BaseHead.astro';
const title = 'Suzanne — 2007 Suzuki RM125 Frame-Up Rebuild | Marc Sherwood';
const description = 'Meet Suzanne, a 2007 Suzuki RM125 brought back through a frame-up rebuild. See the project photographs, teardown, mechanical work, and finished two-stroke. Richmond, BC.';
const photos = [
 {src:'/assets/rm125/finished-side.jpg',alt:'Suzanne, the rebuilt yellow 2007 Suzuki RM125, from the side',caption:'Suzanne · finished RM125'},
 {src:'/assets/rm125/before-project.jpg',alt:'Early stage of the 2007 Suzuki RM125 project in the workshop',caption:'Where it started'},
 {src:'/assets/rm125/frame-work.jpg',alt:'Frame and chassis of the RM125 during the rebuild',caption:'Chassis work'},
 {src:'/assets/rm125/engine-out.jpg',alt:'Suzuki RM125 engine during the mechanical restoration',caption:'Engine work'},
 {src:'/assets/rm125/rebuilt-engine.jpg',alt:'Mechanical rebuild details of the Suzuki RM125',caption:'Under the skin'},
 {src:'/assets/rm125/finished-angle.jpg',alt:'Suzuki RM125 after the build',caption:'Back together'},
 {src:'/assets/rm125/final-driveway.jpg',alt:'Finished RM125 alongside another Suzuki motocross bike',caption:'Ready to ride'},
 {src:'/assets/rm125/finished-pair.jpg',alt:'Finished Suzuki RM125 with other motocross bikes',caption:'The finished project'}
];
---
<!doctype html><html lang="en"><head>
<BaseHead title={title} description={description} /><meta name="theme-color" content="#101b1d" />
<style>
html{scroll-behavior:smooth}body{margin:0;background:#101b1d;color:#f5f4ee;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}*{box-sizing:border-box}a{color:inherit}.wrap{max-width:1160px;margin:auto;padding:0 24px}header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 0}header>a{font-weight:850;text-decoration:none;letter-spacing:-.04em}header b{color:#d8f16a}nav{display:flex;gap:20px;flex-wrap:wrap;font-size:13px}nav a{text-decoration:none;color:#c8d6cf}nav a:hover{color:#d8f16a}.hero{position:relative;background:#1b2929;min-height:660px;display:flex;align-items:center;overflow:hidden}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:55% 55%}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0d191cf5 0%,#0d191ce3 36%,#0d191c24 100%)}.hero-content{position:relative;z-index:1;padding-top:90px;padding-bottom:100px}.eyebrow{text-transform:uppercase;letter-spacing:.17em;color:#d8f16a;font-size:12px;font-weight:800}.hero h1{font-size:clamp(65px,12vw,145px);letter-spacing:-.08em;line-height:.91;margin:16px 0}.hero h1 span{color:#d8f16a}.hero p{font-size:clamp(19px,2.4vw,26px);line-height:1.5;color:#dce6dd;max-width:590px}.btn{display:inline-flex;background:#d8f16a;color:#13211b!important;text-decoration:none;font-weight:800;font-size:14px;padding:16px 23px;margin-top:22px}.section{padding:80px 0;border-bottom:1px solid #364a46}.section.alt{background:#162528}.section h2{font-size:clamp(37px,5vw,62px);line-height:1.08;letter-spacing:-.06em;margin:16px 0 25px}.copy{font-size:18px;line-height:1.8;max-width:820px;color:#cfdbd4}.gallery{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px;margin-top:38px}.photo{grid-column:span 4;position:relative;aspect-ratio:4/3;display:block;overflow:hidden;background:#253435}.photo:nth-child(1),.photo:nth-child(2){grid-column:span 6}.photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .2s}.photo:hover img{transform:scale(1.03)}.photo span{position:absolute;bottom:0;left:0;right:0;padding:30px 13px 13px;background:linear-gradient(transparent,#0e1b1cdb);font-weight:700;font-size:13px}.stages{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:35px}.stage{border:1px solid #3a544c;background:#203335;padding:26px}.stage small{color:#d8f16a;letter-spacing:.15em}.stage h3{font-size:23px;letter-spacing:-.03em}.stage p{line-height:1.75;color:#cbd8d2}.pair{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.pair img{width:100%;display:block}.pair a{color:#d8f16a;font-weight:700}.contact{background:#d8f16a;color:#13211b;padding:80px 0}.contact .eyebrow{color:#596d31}.contact h2{font-size:clamp(40px,6vw,72px);letter-spacing:-.06em;margin:14px 0}.contact p{font-size:18px;line-height:1.7;max-width:690px}.contact .btn{background:#13211b;color:#d8f16a!important}footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding:28px 0;color:#a6b9b0;font-size:12px}a:focus-visible{outline:3px solid #d8f16a;outline-offset:4px}@media(max-width:760px){.hero{min-height:590px}.hero:after{background:linear-gradient(#0d191c9e,#0d191ce8)}.section{padding:60px 0}.stages,.pair{grid-template-columns:1fr}.photo,.photo:nth-child(1),.photo:nth-child(2){grid-column:span 6}}@media(max-width:500px){.photo,.photo:nth-child(1),.photo:nth-child(2){grid-column:span 12}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.photo img{transition:none}}
</style></head><body><header class="wrap"><a href="/">Marc Sherwood<b>.</b></a><nav aria-label="Page navigation"><a href="#story">Her story</a><a href="#rebuild">The rebuild</a><a href="#gallery">Photos</a><a href="/rm250/">RM250</a><a href="#contact">Inquire</a></nav></header><main>
<section class="hero"><img src="/assets/rm125/finished-side.jpg" alt="Suzanne, the 2007 Suzuki RM125 after her frame-up rebuild" fetchpriority="high"/><div class="wrap hero-content"><div class="eyebrow">Project bike / 2007 Suzuki RM125</div><h1>Meet<br/><span>Suzanne.</span></h1><p>A 2007 RM125 two-stroke with a second chapter. Torn down, rebuilt from the frame up, and back together again.</p><a class="btn" href="#gallery">Explore the rebuild ↓</a></div></div></section>
<section class="section" id="story"><div class="wrap"><div class="eyebrow">01 / The story</div><h2>Some bikes get names.<br/>This one earned hers.</h2><div class="copy"><p>Suzanne is my <strong>2007 Suzuki RM125</strong> — the little sister to my 2008 RM250. Instead of being a quick cosmetic refresh, this was a <strong>frame-up rebuild</strong> with the bike stripped down so the work could be done properly.</p><p>The archive follows the project through the dirty, hands-on middle: chassis work, engine and mechanical components, reassembly, and the finished yellow Suzuki.</p><p>She's a separate motorcycle from the RM250, but the two could potentially be rehomed together.</p></div></div></section>
<section class="section alt" id="rebuild"><div class="wrap"><div class="eyebrow">02 / Behind the rebuild</div><h2>More than fresh plastics.</h2><div class="stages"><article class="stage"><small>01 / TEARDOWN</small><h3>Back to the frame</h3><p>The project photos document the bike broken down for substantial chassis and mechanical work.</p></article><article class="stage"><small>02 / WORKSHOP</small><h3>The mechanical work</h3><p>Engine, chassis, suspension, and smaller components are all part of the photographic rebuild record.</p></article><article class="stage"><small>03 / REASSEMBLY</small><h3>Suzanne returns</h3><p>The rebuilt RM125 comes back together in classic Suzuki yellow, ready for her next chapter.</p></article></div><p class="copy" style="font-size:14px;margin-top:25px">The photos establish the rebuild stages; specific newly installed parts and internal engine specifications should be confirmed against build records before making detailed claims.</p></div></section>
<section class="section" id="gallery"><div class="wrap"><div class="eyebrow">03 / Project photographs</div><h2>From pieces to Suzanne.</h2><p class="copy">Selected photographs from the 2007 RM125 project archive. Open any image to see it larger.</p><div class="gallery">{photos.map(photo=><a class="photo" href={photo.src} target="_blank" rel="noopener noreferrer"><img src={photo.src} alt={photo.alt} loading="lazy" decoding="async"/><span>{photo.caption} ↗</span></a>)}</div></div></section>
<section class="section alt"><div class="wrap pair"><div><div class="eyebrow">04 / Two-stroke siblings</div><h2>Meet her big sister.</h2><div class="copy"><p>The 2008 Suzuki RM250 is a separate bike with a race-oriented build. If you're interested in the pair, both stories are here.</p><p><a href="/rm250/">Explore the RM250 →</a></p></div></div><a href="/rm250/"><img src="/assets/rm250/rm250-hero.jpg" alt="2008 Suzuki RM250 with silver graphics" loading="lazy"/></a></div></section>
<section class="contact" id="contact"><div class="wrap"><div class="eyebrow">05 / Inquire</div><h2>Ask about Suzanne.</h2><p>Located in Richmond, BC. Get in touch for more rebuild photos, details, or to discuss whether Suzanne might find a new home alongside the RM250.</p><a class="btn" href="mailto:marcsherwood@gmail.com?subject=Suzanne%20-%202007%20Suzuki%20RM125%20Inquiry">Email about Suzanne ↗</a></div></section></main><footer class="wrap"><span>© Marc Sherwood · Richmond, BC</span><a href="/">Back to marcsherwood.com</a></footer></body></html>
