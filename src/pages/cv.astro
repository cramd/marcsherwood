---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubProfile from '../components/GitHubProfile.astro';

const capabilities = [
  { title: 'Customer-led positioning', detail: 'Work with field teams to understand what customers actually need, then turn those insights into the core messaging for new technical products and services.', evidence: 'Product messaging · Customer discovery · Field intelligence' },
  { title: 'Technical translation', detail: 'Connect engineering capabilities to the problems customers are solving and the decisions business leaders need to make, without losing the technical substance.', evidence: 'Docker · VictoriaMetrics · Enterprise infrastructure' },
  { title: 'Commercial systems thinking', detail: 'Examine the entire journey from discovery and adoption to revenue, looking for friction between product, marketing, sales and the people buying.', evidence: 'Open-source GTM · Sales enablement · Product-led growth' },
  { title: 'Applied AI and rapid prototyping', detail: 'Turn an observed problem into a working application, test assumptions with real workflows, and improve the system using feedback and instrumentation.', evidence: 'HoneOS · HuntMode · LLM applications' },
];

const projects = [
  {
    name: 'HoneOS', type: 'Commercial intelligence', year: '2026',
    problem: 'Technical sales teams spend too much time researching accounts and too little time making sense of what matters.',
    built: 'An AI-assisted research platform that connects public engineering signals, account context and evidence-backed sales narratives. Built with feedback workflows, model selection, cost and latency monitoring, and product analytics.',
    stack: ['React', 'Node.js', 'LLM APIs', 'Cloud Run', 'PostHog'],
    href: 'https://honeos.ai', link: 'Explore HoneOS',
  },
  {
    name: 'HuntMode', type: 'Applied AI / decision support', year: '2026',
    problem: 'Job descriptions and résumés make it difficult to distinguish real alignment from keyword matches.',
    built: 'A workflow that assesses role fit against career evidence, identifies gaps, and supports targeted applications and interview preparation.',
    stack: ['LLM APIs', 'Evidence mapping', 'Product analytics'],
    href: 'https://github.com/cramd/huntmode', link: 'View HuntMode on GitHub',
  },
  {
    name: 'Looking Glass', type: 'Infrastructure observability', year: '2026',
    problem: 'Understanding the health of a home infrastructure environment requires visibility across multiple systems.',
    built: 'A deployment and monitoring project connecting a Proxmox environment to VictoriaMetrics through ShiftMon, with automated infrastructure monitoring and dashboards.',
    stack: ['Proxmox', 'VictoriaMetrics', 'Docker', 'Ansible'],
  },
  {
    name: 'Social Battery', type: 'Personal software experiment', year: '2026',
    problem: 'Daily activities can consume energy in ways that are difficult to recognize until after the fact.',
    built: 'A mobile-first personal energy-tracking application with a self-hosted deployment environment.',
    stack: ['Mobile development', 'Tailscale', 'Self-hosting'],
  },
];

const experience = [
  {
    name: 'HoneOS', role: 'Founder & PLG Strategist', period: 'Jan 2026 – Present',
    body: 'Developing a commercial intelligence platform informed by experience selling and marketing enterprise and open-source technology.',
    points: [
      'Translate enterprise sales and research problems into product workflows, prototypes and experiments.',
      'Build and instrument an AI-assisted application, incorporating user feedback and monitoring model cost, latency and usage.',
      'Develop positioning and go-to-market experiments for commercial open-source companies.',
    ],
  },
  {
    name: 'VictoriaMetrics', role: 'Technical Marketing & PLG', period: 'Nov 2024 – Feb 2026',
    body: 'Worked at the intersection of technical marketing, developer adoption and sales enablement for high-performance observability infrastructure.',
    points: [
      'Developed positioning and technical content connecting time-series database capabilities with customer and business requirements.',
      'Supported the field with competitive intelligence, enablement and feedback on commercial packaging.',
      'Worked on self-serve onboarding, conversion and developer-focused monetization initiatives.',
    ],
  },
  {
    name: 'Docker', role: 'Technical Marketing · AI/ML subject matter expertise',
    body: 'Connected containerization, developer workflows and AI/ML use cases to customer needs and commercial narratives.',
    points: [
      'Developed executive messaging, partner content, customer stories, webcasts and sales enablement.',
      'Worked on AI/ML initiatives, including a 12-week project with the Berkeley Management, Entrepreneurship, & Technology program.',
      'Translated technical capabilities into their practical implications for different audiences.',
    ],
  },
];

const domains = [
  { title: 'Commercial & customer', items: ['Enterprise sales', 'Product positioning', 'Customer discovery', 'Sales enablement', 'Commercial open source', 'Product-led growth'] },
  { title: 'Infrastructure & data', items: ['Observability', 'Metrics · logs · traces', 'Containers', 'Databases & search', 'Docker', 'VictoriaMetrics'] },
  { title: 'Applied development', items: ['JavaScript / TypeScript', 'Python · SQL · Bash', 'React / Node.js', 'LLM APIs', 'Cloud deployment', 'Product analytics'] },
];
---

<BaseLayout title="Marc Sherwood | Technical Strategist, GTM & Applied AI" description="Marc Sherwood — technical strategist and hands-on builder connecting customer needs, commercial strategy, infrastructure and applied AI." mainClass="flex-grow w-full">
  <section class="bg-slate-900 text-white border-b border-slate-700">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <p class="text-sm font-mono text-blue-300 mb-5">Marc Sherwood · Richmond / Vancouver, BC</p>
      <div class="grid lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-tight mb-6">
            Technical strategist.<br />Systems thinker.<br /><span class="text-blue-300">Hands-on builder.</span>
          </h1>
          <p class="text-lg md:text-xl text-slate-200 leading-relaxed max-w-3xl">
            I connect what technology can do with what people and businesses actually need. My experience spans enterprise software, open-source infrastructure, commercial strategy and applied AI.
          </p>
          <div class="flex flex-wrap gap-3 mt-8">
            <a href="mailto:marc@honeos.ai?subject=Professional%20opportunity" class="px-5 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition-colors">Get in touch</a>
            <a href="https://linkedin.com/in/marcsherwood" class="px-5 py-3 border border-slate-500 hover:border-blue-300 text-white font-semibold rounded-lg transition-colors">LinkedIn</a>
            <a href="#experience" class="px-5 py-3 border border-slate-500 hover:border-blue-300 text-white font-semibold rounded-lg transition-colors">Career experience</a>
          </div>
        </div>
        <aside class="lg:col-span-4 border-l-2 border-blue-400 pl-6 py-2">
          <p class="font-mono text-sm text-blue-300 uppercase tracking-wider mb-3">Where I add value</p>
          <p class="text-xl font-semibold leading-snug">When a problem crosses the boundaries between technology, customers and business, that's usually where I want to be.</p>
          <p class="text-slate-300 mt-5">Open to full-time and fractional opportunities, including technical strategy, innovation and product commercialization.</p>
        </aside>
      </div>
    </div>
  </section>

  <nav aria-label="CV sections" class="border-b border-slate-200 bg-white">
    <div class="max-w-6xl mx-auto px-6 flex flex-wrap gap-x-6 gap-y-3 py-4 text-sm font-semibold text-slate-700">
      <a href="#capabilities" class="hover:text-blue-700">Capabilities</a>
      <a href="#featured-projects" class="hover:text-blue-700">Projects</a>
      <a href="#experience" class="hover:text-blue-700">Experience</a>
      <a href="#approach" class="hover:text-blue-700">How I work</a>
      <a href="#skills" class="hover:text-blue-700">Technical & commercial skills</a>
    </div>
  </nav>

  <section id="capabilities" class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <p class="text-sm font-mono font-medium text-blue-700 uppercase tracking-wider mb-3">What I bring</p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">Different disciplines. One way of thinking.</h2>
    <p class="text-lg text-slate-600 max-w-3xl mb-9">I have worked across the commercial and technical sides of enterprise technology. The useful part is what happens when those perspectives come together.</p>
    <div class="grid md:grid-cols-2 gap-5">
      {capabilities.map((item) => (
        <article class="glass-panel rounded-2xl border border-slate-200 p-6 md:p-8 flex flex-col">
          <h3 class="text-xl font-bold text-slate-900 mb-3">{item.title}</h3>
          <p class="text-slate-600 leading-relaxed flex-grow">{item.detail}</p>
          <p class="text-sm font-medium text-blue-700 mt-5 pt-4 border-t border-slate-200">{item.evidence}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-blue-50 border-y border-blue-100">
    <div class="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-5">
        <p class="text-sm font-mono text-blue-700 uppercase tracking-wider mb-3">A recurring thread</p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">The field is a source of intelligence.</h2>
      </div>
      <div class="md:col-span-7 text-lg text-slate-700 leading-relaxed">
        <p>Much of my positioning work has started with conversations with field teams: understanding the problems customers are trying to solve, finding the disconnects, and connecting what we build to why it matters.</p>
        <p class="mt-4 font-semibold text-slate-900">That same habit of listening, investigating and testing now informs the products I build.</p>
      </div>
    </div>
  </section>

  <section id="featured-projects" class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <p class="text-sm font-mono font-medium text-blue-700 uppercase tracking-wider mb-3">Selected projects</p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">From problem to working software.</h2>
    <p class="text-lg text-slate-600 max-w-3xl mb-9">These projects illustrate how I investigate problems, design practical workflows, build applications and learn from their operation.</p>
    <div class="grid md:grid-cols-2 gap-5">
      {projects.map((project) => (
        <article class="glass-panel border border-slate-200 rounded-2xl overflow-hidden flex flex-col">
          <div class="bg-slate-900 p-6 md:p-8 text-white">
            <div class="flex flex-wrap gap-2 items-center justify-between text-sm text-blue-200 mb-4">
              <span>{project.type}</span><time>{project.year}</time>
            </div>
            <h3 class="text-3xl font-bold tracking-tight">{project.name}</h3>
          </div>
          <div class="p-6 md:p-8 flex flex-col flex-grow">
            <p class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-2">The problem</p>
            <p class="text-slate-700 mb-5">{project.problem}</p>
            <p class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-2">What I built</p>
            <p class="text-slate-700 leading-relaxed mb-6 flex-grow">{project.built}</p>
            <ul class="flex flex-wrap gap-2 mb-4">
              {project.stack.map((tag) => <li class="rounded-md bg-blue-50 border border-blue-100 px-3 py-1 text-sm text-blue-800">{tag}</li>)}
            </ul>
            {project.href && <a href={project.href} class="text-blue-700 font-semibold hover:text-blue-900 mt-2">{project.link}</a>}
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-slate-500">Projects include active products and personal experiments; their inclusion is evidence of practical work, not a claim of commercial adoption or revenue.</p>
  </section>

  <section id="experience" class="bg-white border-y border-slate-200">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <p class="text-sm font-mono font-medium text-blue-700 uppercase tracking-wider mb-3">Career experience</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-9">Commercial experience. Technical depth.</h2>
      <div class="space-y-0 divide-y divide-slate-200 border-y border-slate-200">
        {experience.map((item) => (
          <article class="grid md:grid-cols-12 gap-5 md:gap-10 py-8">
            <div class="md:col-span-4">
              <h3 class="text-2xl font-bold text-slate-900">{item.name}</h3>
              <p class="font-medium text-blue-700 mt-1">{item.role}</p>
              {item.period && <p class="font-mono text-sm text-slate-500 mt-2">{item.period}</p>}
            </div>
            <div class="md:col-span-8">
              <p class="text-slate-800 font-medium leading-relaxed mb-4">{item.body}</p>
              <ul class="list-disc pl-5 space-y-2 text-slate-600 leading-relaxed">
                {item.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 mt-8">
        <h3 class="text-lg font-bold text-slate-900 mb-3">Earlier enterprise technology experience</h3>
        <p class="text-slate-600 mb-4">My background also includes experience across enterprise sales, security, databases, search and observability at organizations including:</p>
        <ul class="flex flex-wrap gap-2">
          {['Elastic', 'Splunk', 'MariaDB', 'Percona', 'Sophos'].map((name) => <li class="rounded-md px-3 py-2 bg-white border border-slate-200 font-semibold text-slate-800">{name}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="approach" class="bg-slate-900 text-slate-100">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <p class="text-sm font-mono text-blue-300 uppercase tracking-wider mb-3">How I work</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-9">Understand the system. Test the assumption.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          ['Investigate', 'Start with the real problem. Talk to people closest to it and look for the patterns.'],
          ['Connect', 'Bring together technical, commercial and customer perspectives to understand the system.'],
          ['Prototype', 'Make the idea tangible. Build something or design an experiment that tests the hypothesis.'],
          ['Learn', 'Measure what happens, challenge the assumptions and change direction when the evidence says to.'],
        ].map(([title, detail]) => (
          <article class="border-t-2 border-blue-400 pt-5">
            <h3 class="text-xl font-bold text-white mb-3">{title}</h3>
            <p class="text-slate-300 leading-relaxed">{detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="skills" class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <p class="text-sm font-mono font-medium text-blue-700 uppercase tracking-wider mb-3">Tools and disciplines</p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-8">A working vocabulary across teams.</h2>
    <div class="grid md:grid-cols-3 gap-5">
      {domains.map((domain) => (
        <article class="glass-panel p-6 rounded-xl border border-slate-200">
          <h3 class="text-lg font-bold text-slate-900 mb-4">{domain.title}</h3>
          <ul class="space-y-2.5 text-slate-700">
            {domain.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <div class="glass-panel p-6 md:p-8 rounded-2xl mt-8">
      <h3 class="text-xl font-bold text-slate-900 mb-5">Open source & development</h3>
      <GitHubProfile compact={true} />
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-8">
        <p class="text-sm font-mono font-medium text-blue-700 uppercase tracking-wider mb-3">What's next</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">Meaningful problems and room to build.</h2>
        <p class="text-lg text-slate-600 leading-relaxed">I'm interested in roles where I can investigate complex problems, collaborate across disciplines, and turn ideas into action. That includes opportunities in technical GTM, digital innovation and applied AI, in technology companies and beyond.</p>
        <p class="text-sm text-slate-500 mt-4">Based in the Vancouver area. Open to remote and hybrid work.</p>
      </div>
      <div class="md:col-span-4 flex flex-col gap-3">
        <a href="mailto:marc@honeos.ai?subject=Professional%20opportunity" class="text-center px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors">Start a conversation</a>
        <a href="/gtm" class="text-center px-5 py-3 glass-panel text-slate-800 font-semibold rounded-lg hover:border-blue-300 transition-colors">Fractional GTM services</a>
        <a href="/blog" class="text-center px-5 py-3 glass-panel text-slate-800 font-semibold rounded-lg hover:border-blue-300 transition-colors">Read my writing</a>
      </div>
    </div>
  </section>
</BaseLayout>
