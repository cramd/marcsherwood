---
import BaseHead from '../components/BaseHead.astro';
const title = 'Operation Thrifty Jeep | 2013 Jeep Wrangler JK | Marc Sherwood';
const description = 'A one-owner 2013 two-door Wrangler Sport built for technical BC trails: 35s, 4.88 gears, rear ARB locker and thoughtful protection. The Operation Thrifty Jeep story.';
const dir = '/assets/thriftyjeep/';
const photos = [
  ['technical-climb.jpg','A technical rock climb in the BC woods','The line is everything.'],
  ['wheel-placement.jpg','Black JK negotiating a rocky forest trail with its front axle articulated','Four wheels. Four decisions.'],
  ['airing-up.jpg','Wrangler with an air hose connected at the trail','Onboard air in use.'],
  ['onboard-air.jpg','Wrangler in the forest with the hood open and compressor hose visible','Practical trail equipment.'],
  ['tube-doors.jpg','Black two-door Wrangler with tubular trail doors','Open-air configuration.'],
  ['cargo-and-bike.jpg','Wrangler carrying camping gear and a Suzuki motorcycle on a ferry','More than a trail rig.'],
  ['trail-obstacle.jpg','A rocky ledge on a forest trail with another Jeep at the top','The terrain that inspired the build.'],
  ['club-panorama.jpg','A group of Jeeps on a lakeshore with mountains beyond','Good trails. Better company.'],
];
const groups = [
  {title:'Suspension & traction',parts:['TeraFlex suspension and shocks · approximately 2.5-inch lift','35-inch tires on aluminum wheels','4.88 axle gearing','Rear ARB air locker','Automatic transmission']},
  {title:'Armour & recovery',parts:['Full underbody skid plates','ACE rock sliders and underside protection','Steel front and rear bumpers','8,000 lb front winch','Auxiliary off-road lights']},
  {title:'Practical trail gear',parts:['Onboard air compressor for tire inflation and locker operation','Hardtop and soft top','Full doors and tubular trail doors','Tilting Kargo Master Congo Cage for roof access','Customized as the build evolved']},
];
---
<!doctype html>
<html lang="en"><head><BaseHead title={title} description={description} image={{src:dir+'wheel-placement.jpg',width:1400,height:1400}}/><meta name="theme-color" content="#18221c"/>
<style>
html{scroll-behavior:smooth}body{margin:0;background:#18221c;color:#f6f4e9;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}*{box-sizing:border-box}a{color:inherit}.wrap{max-width:1160px;margin:auto;padding:0 24px}header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0}header>a{font-weight:850;text-decoration:none}header b,.eyebrow{color:#d9e887}nav{display:flex;gap:18px;flex-wrap:wrap;font-size:14px}nav a{text-decoration:none;color:#dce2d7}.hero{position:relative;overflow:hidden;background:#1b2920}.hero>img{position:absolute;width:100%;height:100%;object-fit:cover;object-position:70% 55%;inset:0}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#101a13f5 0%,#101a13d0 40%,#101a1330 100%)}.hero .wrap{position:relative;z-index:1;padding-top:100px;padding-bottom:110px;min-height:570px;display:flex;flex-direction:column;justify-content:center}.eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:850}.hero h1{font-size:clamp(60px,10vw,125px);letter-spacing:-.085em;line-height:.91;margin:20px 0 24px;font-weight:900}.hero h1 span{color:#d9e887}.lead{font-size:clamp(19px,2.5vw,26px);max-width:550px;line-height:1.5;color:#e0e8db}.btn{display:inline-block;background:#d9e887;color:#19241a!important;padding:15px 22px;text-decoration:none;font-weight:800;align-self:flex-start;margin-top:18px}.stats{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #536050;background:#202e24}.stat{padding:25px 15px;text-align:center;border-right:1px solid #536050}.stat strong{font-size:clamp(22px,4vw,40px);display:block;color:#e6eda9;letter-spacing:-.05em}.stat span{font-size:13px;color:#d4ddcf}.section{padding:80px 0;border-bottom:1px solid #536050}.alt{background:#223229}.section h2{font-size:clamp(38px,6vw,70px);line-height:1.05;letter-spacing:-.06em;margin:14px 0 26px}.copy{font-size:18px;line-height:1.8;color:#dce4d6;max-width:820px}.quote{font-size:clamp(25px,4vw,44px);line-height:1.22;letter-spacing:-.045em;margin:32px 0;border-left:5px solid #d9e887;padding-left:24px;font-weight:750}.split{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center}.split img{width:100%;display:block}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:30px}.photo{display:block;background:#26352a;text-decoration:none}.photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}.photo span{display:block;padding:14px;font-weight:700}.photo:last-child{grid-column:span 2}.photo:last-child img{aspect-ratio:auto;object-fit:contain}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:30px}.card{background:#29392d;border:1px solid #536050;padding:25px}.card h3{font-size:23px;letter-spacing:-.035em;margin:0 0 20px}.card ul{padding-left:20px;line-height:1.7;color:#dce4d6}.card li+li{margin-top:9px}.note{font-size:14px;color:#c4d1c0;line-height:1.65}.contact{background:#d9e887;color:#17241a;padding:70px 0}.contact .eyebrow{color:#53672b}.contact h2{font-size:clamp(40px,6vw,70px);letter-spacing:-.06em;line-height:1;margin:14px 0 25px}.contact p{font-size:18px;line-height:1.65;max-width:750px}.contact .btn{background:#17241a;color:#d9e887!important}footer{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;padding:25px 0;font-size:13px;color:#bac9b9}video{width:100%;background:#101a13;display:block;margin-top:25px;max-height:640px}:focus-visible{outline:3px solid #d9e887;outline-offset:4px}@media(max-width:760px){.hero:after{background:linear-gradient(90deg,#101a13e0,#101a1366)}.hero .wrap{min-height:540px;padding-block:65px}.section{padding:55px 0}.cards,.split{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.gallery{grid-template-columns:1fr}.photo:last-child{grid-column:auto}.photo img{object-fit:contain;background:#17241a}header{align-items:flex-start;flex-direction:column}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
.featured-video{margin:34px 0}.featured-video h3{font-size:clamp(24px,3vw,36px);margin:10px 0 18px;letter-spacing:-.035em}.featured-video iframe{display:block;width:100%;aspect-ratio:16/9;border:0;background:#101a13}.hero{display:grid;grid-template-columns:1fr 1fr;align-items:center}.hero>img{position:static;grid-column:2;grid-row:1;width:100%;height:auto;aspect-ratio:1;object-fit:contain}.hero:after{display:none}.hero .wrap{grid-column:1;grid-row:1;min-height:0;width:100%;max-width:none;padding:55px clamp(24px,5vw,80px)}.hero h1{font-size:clamp(56px,7vw,106px)}.compgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:28px 0}.price{display:block;color:#d9e887;font-size:30px;letter-spacing:-.04em}.compgrid .card a{text-decoration:underline}.compgrid .card p{line-height:1.65}@media(max-width:760px){.hero{grid-template-columns:1fr}.hero>img{grid-column:1;grid-row:1}.hero .wrap{grid-column:1;grid-row:2;padding:32px 24px 48px}.compgrid{grid-template-columns:1fr}}</style></head><body>
<header class="wrap"><a href="/">Marc Sherwood<b>.</b></a><nav aria-label="Page navigation"><a href="#story">The mission</a><a href="#trail">On the trail</a><a href="#build">The build</a><a href="#condition">Condition</a><a href="#market">Market context</a><a href="#contact">Inquire</a></nav></header>
<main><section class="hero"><img src={dir+'wheel-placement.jpg'} alt="Operation Thrifty Jeep articulating its front axle across a rocky forest trail" fetchpriority="high"/><div class="wrap"><div class="eyebrow">2013 Jeep Wrangler Sport · British Columbia</div><h1>Operation<br/><span>Thrifty Jeep.</span></h1><p class="lead">Build the driver. Build the Jeep. Earn every upgrade.</p><a class="btn" href="#story">The story behind the build</a></div></section>
<div class="stats"><div class="stat"><strong>2013</strong><span>Original owner</span></div><div class="stat"><strong>38–39k</strong><span>Approx. kilometres</span></div><div class="stat"><strong>35″</strong><span>Trail tires</span></div><div class="stat"><strong>4.88</strong><span>Axle gearing</span></div></div>
<section class="section" id="story"><div class="wrap"><div class="eyebrow">01 / The mission</div><h2>Build, not buy then build.</h2><div class="copy"><p>In 2013, I bought the most affordable new Jeep on the lot: a black two-door Wrangler Sport. The goal was never to buy a Rubicon, bolt on every accessory in the catalogue and head to Hale Creek. I wanted to build the Jeep and my own driving skills together.</p><p>I documented the project as <strong>Operation Thrifty Jeep</strong> on BC Jeep Club and BC 4x4. Every modification had to earn its place on the terrain I actually enjoyed: technical forest trails, precise wheel placement, controlled throttle and braking, and the satisfaction of clearing a difficult obstacle without drama.</p><p>It wasn't a purpose-built rock buggy. It was a reliable new Jeep made progressively more capable, with money spent where it mattered.</p></div><div class="quote">The best upgrade was learning where to put each wheel.</div></div></section>
<section class="section alt" id="trail"><div class="wrap"><div class="split"><div><div class="eyebrow">02 / Proof on the trail</div><h2>Finesse over wheelspin.</h2><div class="copy"><p>My favourite moments were cleaning V-Rock or the hard way into the Cat Lake trail — with a roughly four-foot drop in and a climb back out — while some rigs costing well over $100,000 needed a winch or chose a different line.</p><p>That wasn't about somebody else's Jeep being bad. It was about the satisfaction of reading the terrain, knowing my own vehicle, and making a clean line with little or no wheelspin. This Jeep could find power when needed, but restraint and touch were the fun part.</p><p>Useful articulation matters more than lift height alone. The goal is to keep the tires working against the terrain, with suspension travel properly controlled by bump stops and limiting straps. More usable travel, not uncontrolled travel.</p></div></div><img src={dir+'glider.jpg'} alt="The black Wrangler on a rainy British Columbia trail" loading="lazy"/></div><div class="featured-video"><div class="eyebrow">Featured trail footage</div><h3>Watch Thrifty Jeep in action.</h3><iframe src="https://www.youtube-nocookie.com/embed/jBTrRt6q_84?start=146" title="Operation Thrifty Jeep on the trail — starting at 2:26" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe><p class="note">Starts at 2:26. <a href="https://youtu.be/jBTrRt6q_84?t=146" target="_blank" rel="noopener noreferrer">Watch on YouTube</a> if the embedded player is unavailable.</p></div><div class="featured-video"><div class="eyebrow">Technical trail driving</div><h3>Three wheels. Still moving.</h3><p class="copy">This clip shows another side of the build: negotiating uneven terrain when one wheel lifts. The satisfaction comes from composure, traction and precise control, rather than simply throwing more power at the obstacle.</p><iframe src="https://www.youtube-nocookie.com/embed/mazDMT7xGLI?start=62" title="Operation Thrifty Jeep — three-wheel trail articulation at 1:02" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe><p class="note">Starts at 1:02. <a href="https://youtu.be/mazDMT7xGLI?t=62" target="_blank" rel="noopener noreferrer">Watch on YouTube</a>.</p></div><video controls playsinline preload="metadata" poster={dir+'technical-climb.jpg'}><source src={dir+'trail-video.mp4'} type="video/mp4"/>Your browser does not support embedded video.</video><p class="note">Archive trail footage from 2014.</p><div class="gallery">{photos.map(([file,alt,caption])=><a class="photo" href={dir+file} target="_blank" rel="noopener noreferrer"><img src={dir+file} alt={alt} loading="lazy" decoding="async"/><span>{caption}</span></a>)}</div><p class="note">Archive pictures from several stages of the build. Equipment shown in historical photographs may differ from what is installed or included today.</p></div></section>
<section class="section" id="build"><div class="wrap"><div class="eyebrow">03 / The hardware</div><h2>Every modification had a job.</h2><div class="cards">{groups.map(group=><article class="card"><h3>{group.title}</h3><ul>{group.parts.map(part=><li>{part}</li>)}</ul></article>)}</div><p class="note">Exact current inventory and condition to be confirmed at viewing; motorcycle and other cargo in the archive photos are not included.</p></div></section>
<section class="section alt" id="condition"><div class="wrap"><div class="eyebrow">04 / Today's condition</div><h2>Ready for its next chapter.</h2><div class="copy"><p>I've owned the Jeep since new. It has approximately 38,000–39,000 km, and it has been sitting for a couple of years. There is interior mold from storage that needs to be addressed. The photos above document its trail history, not its present condition.</p><p>I'm considering letting it go to someone who appreciates what went into the build. Current photos, mileage and mechanical condition can be confirmed before any sale. It should be inspected and serviced as appropriate after the extended storage.</p></div></div></section>
<section class="section" id="market"><div class="wrap"><div class="eyebrow">05 / Market context</div><h2>What else is out there?</h2><p class="copy">For perspective, here are advertised examples of comparable two-door JKs in British Columbia. My Jeep's approximately 38–39,000 km and purpose-built equipment are worth considering alongside its need for recommissioning after storage.</p><div class="compgrid"><article class="card"><div class="eyebrow">Same model year · Dealer</div><h3>2013 Wrangler Sport</h3><strong class="price">$15,995 CAD</strong><p>Manual · Campbell River<br/>Mileage not stated on listing.</p><a href="https://www.campbellrivercars.ca/used/2013-Jeep-Wrangler-id14675789.html" target="_blank" rel="noopener noreferrer">River City Ram listing</a></article><article class="card"><div class="eyebrow">Automatic · Dealer</div><h3>2014 Wrangler Sport</h3><strong class="price">$16,499 CAD</strong><p>88,955 km · Duncan<br/>Automatic; over twice the mileage.</p><a href="https://www.cargurus.ca/Cars/s-Used-Jeep-Wrangler-Under-40000-Qualicum-Beach-d494_spt388_L273244" target="_blank" rel="noopener noreferrer">CarGurus listing snapshot</a></article><article class="card"><div class="eyebrow">Automatic · Dealer</div><h3>2015 Wrangler Sport</h3><strong class="price">$21,999 CAD</strong><p>90,342 km · Surrey<br/>Two-door automatic.</p><a href="https://inventory.vancouverautohaus.ca/inventory/2015-jeep-wrangler-sport-ZLXOjucmQca18dmedC0ZnAvdp/" target="_blank" rel="noopener noreferrer">Vancouver Auto Haus listing</a></article><article class="card"><div class="eyebrow">Modified · Private listing</div><h3>2014 Wrangler Sport</h3><strong class="price">$21,000 CAD</strong><p>96,800 km · Houston, BC<br/>Manual, 2.5-inch lift, cage, upgraded bumpers and 34-inch tires; no winch listed.</p><a href="https://www.kijiji.ca/v-cars-trucks/houston-bc/for-sale/1745888891" target="_blank" rel="noopener noreferrer">Kijiji listing</a></article></div><p class="note">Research snapshot: November 26, 2026. Advertised asking prices, not completed sales; some source listings may change or expire. Dealer taxes and fees may be additional. Differences in age, condition, maintenance, transmission and equipment matter; these examples are context, not a formal valuation.</p><p class="copy">The point of Thrifty Jeep was to allocate money to functional capability. The gears, locker, armour, suspension, recovery gear and roof system are already part of the build — rather than a shopping list for the next owner.</p></div></section><section class="contact" id="contact"><div class="wrap"><div class="eyebrow">06 / Get in touch</div><h2>Noah, this could be yours.</h2><p style="font-size:clamp(24px,4vw,42px);font-weight:850;letter-spacing:-.04em;margin:0 0 16px">$16,000 CAD for Noah. $21,000 CAD for anyone else.</p><p>Richmond, British Columbia. I’d love to see Operation Thrifty Jeep stay in the family and get back out on the trails. Get in touch to discuss the Jeep, its current condition and a viewing.</p><a class="btn" href="mailto:marcsherwood@gmail.com?subject=Operation%20Thrifty%20Jeep%20Inquiry">Email about the Jeep</a></div></section></main>
<footer class="wrap"><span>© Marc Sherwood · British Columbia</span><a href="/">Back to marcsherwood.com</a></footer></body></html>
