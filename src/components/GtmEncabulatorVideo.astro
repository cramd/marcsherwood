---
interface Props {
	/** Set when film is ready, e.g. `/gtm/encabulator.mp4` */
	src?: string;
	/** Optional poster, e.g. `/gtm/encabulator-poster.jpg` */
	poster?: string;
	title?: string;
	subtitle?: string;
}

const {
	src,
	poster,
	title = 'The Commercial Open-Source Revenue Encabulator™',
	subtitle = 'One product. Three stories. Zero shared understanding.',
} = Astro.props;

const titleId = 'encabulator-video-title';
const descId = 'encabulator-video-desc';
---

<div class="max-w-4xl mx-auto w-full" data-gtm-video-root>
	<p id={descId} class="sr-only">
		Parody film placeholder: how a technically excellent product becomes commercially incomprehensible when the founder,
		sales team, and technical users each tell a different story.
	</p>

	{
		src ? (
			<div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900 shadow-xl aspect-video">
				<video
					class="w-full h-full object-cover"
					controls
					preload="metadata"
					playsinline
					poster={poster}
					aria-labelledby={`${titleId} ${descId}`}
					data-gtm-encabulator-video
				>
					<source src={src} type="video/mp4" />
					Your browser does not support the video tag.
				</video>
			</div>
		) : (
			<div
				class="relative rounded-xl overflow-hidden border border-slate-800 bg-slate-900 shadow-xl aspect-video flex flex-col items-center justify-center text-center px-6"
				role="img"
				aria-labelledby={titleId}
				aria-describedby={descId}
			>
				<div class="absolute inset-0 opacity-20 bg-[linear-gradient(135deg,transparent_40%,rgba(37,99,235,0.15)_100%)]" />
				<div class="relative z-10 max-w-lg">
					<div
						class="mx-auto mb-6 w-16 h-16 rounded-full bg-slate-800 border border-slate-600 flex items-center justify-center encabulator-play"
						aria-hidden="true"
					>
						<svg class="w-8 h-8 text-blue-400 ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M8 5v14l11-7z" />
						</svg>
					</div>
					<h3 id={titleId} class="text-xl sm:text-2xl font-bold text-white mb-2 tracking-tight">
						{title}
					</h3>
					<p class="text-slate-400 text-sm sm:text-base italic">{subtitle}</p>
					<p class="text-slate-500 text-xs font-mono mt-6">Film in production — video will appear here</p>
				</div>
			</div>
		)
	}
</div>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.encabulator-play {
			animation: encabulator-pulse 2.5s ease-in-out infinite;
		}
	}

	@keyframes encabulator-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.35);
		}
		50% {
			box-shadow: 0 0 0 12px rgba(59, 130, 246, 0);
		}
	}
</style>
