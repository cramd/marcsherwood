rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /parts/{partId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
