---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { assemblyCodes } from '../data/assemblyCodes';
---

<BaseLayout title="Reference" description="Factory assembly codes, photo guide, and workshop reference for the Sebring 350." mainClass="flex-grow max-w-7xl mx-auto px-4 sm:px-6 py-12">
	<Header slot="header" />
	<Footer slot="footer" />

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fade-up">
		<div class="lg:col-span-2">
			<div class="ducati-border pl-4 mb-6">
				<h1 class="text-3xl font-bold">Factory assembly reference</h1>
				<p class="text-stone-600 mt-2">
					Factory-correct codes for physical storage bins and photo inventory. Label an index card with the code before shooting — keeps the digital catalog synced with the workshop manual.
				</p>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				{
					assemblyCodes.map((item) => (
						<div class="workshop-panel p-4 rounded-lg hover:shadow-md transition-shadow">
							<div class="flex items-center mb-2">
								<span class="bg-[var(--ducati-red)] text-white text-xs font-bold px-2 py-1 rounded mr-3">{item.code}</span>
								<h2 class="font-bold text-stone-800">{item.area}</h2>
							</div>
							<p class="text-xs text-stone-500 leading-relaxed">{item.parts}</p>
						</div>
					))
				}
			</div>
		</div>

		<div class="space-y-8">
			<div class="workshop-panel p-6 rounded-xl">
				<h2 class="text-xl font-bold mb-4">Lift table guide</h2>
				<p class="text-sm text-stone-700 mb-4">
					For a 123 kg Sebring, a 1,000 lb lift is ideal. Target prices at Princess Auto:
				</p>
				<ul class="space-y-2 text-sm">
					<li class="flex justify-between"><span>Powerfist foot pump</span> <span class="font-bold text-emerald-700">$430 – $460</span></li>
					<li class="flex justify-between"><span>Pro.Point pneumatic</span> <span class="font-bold text-emerald-700">$699</span></li>
				</ul>
				<p class="mt-4 p-3 bg-stone-50 rounded border border-stone-200 text-xs text-stone-500 italic">
					Tip: used Titan or Powerfist lifts on FB Marketplace in the Lower Mainland.
				</p>
			</div>

			<div class="workshop-panel p-6 rounded-xl ducati-border">
				<h2 class="text-xl font-bold mb-4 text-[var(--charcoal)]">Photo best practices</h2>
				<ul class="space-y-4 text-sm text-stone-700">
					<li class="flex items-start gap-3">
						<span class="text-[var(--ducati-red)] font-bold font-mono shrink-0">01</span>
						<span><strong class="text-[var(--charcoal)]">Knoll the parts:</strong> lay items flat on a high-contrast background.</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="text-[var(--ducati-red)] font-bold font-mono shrink-0">02</span>
						<span><strong class="text-[var(--charcoal)]">Scale reference:</strong> include a ruler or coin in the frame.</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="text-[var(--ducati-red)] font-bold font-mono shrink-0">03</span>
						<span><strong class="text-[var(--charcoal)]">Maker's marks:</strong> close-ups of bearing brands and date stamps.</span>
					</li>
				</ul>
			</div>
		</div>
	</div>
</BaseLayout>
