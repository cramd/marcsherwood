---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LiveInventory from '../components/LiveInventory';
import { SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title="Inventory" description="Master inventory for the 1965 Ducati Sebring 350 restoration." mainClass="flex-grow max-w-7xl mx-auto px-4 sm:px-6 py-12">
	<Header slot="header" />
	<Footer slot="footer" />

	<section class="mb-12 animate-fade-up">
		<div class="ducati-border pl-4 mb-6">
			<h1 class="text-3xl font-bold tracking-tight">Master inventory explorer</h1>
			<p class="text-stone-600 max-w-3xl mt-2">
				Search through logged components by photo ID, factory part number, or assembly code. Filter by status to see what needs cleaning, what's missing, or what's ready to bolt on.
			</p>
		</div>
		<LiveInventory client:load mode="table" showPhotos={true} />
	</section>
</BaseLayout>
