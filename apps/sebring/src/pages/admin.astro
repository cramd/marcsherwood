---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdminPanel from '../components/AdminPanel';
---

<BaseLayout title="Admin" description="Sebring restoration admin — catalog parts and manage inventory." mainClass="flex-grow max-w-5xl mx-auto px-4 sm:px-6 py-12">
	<Header slot="header" />
	<Footer slot="footer" />
	<AdminPanel client:load />
</BaseLayout>
