---
import { PROJECT_STARTED, BRAND_NAME } from '../consts';
---

<footer class="mt-auto border-t border-stone-200 bg-stone-100/80 py-10">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
		<p class="font-display text-2xl tracking-wide text-[var(--charcoal)] mb-2">{BRAND_NAME}</p>
		<p class="text-sm text-stone-500 mb-4">1965 Ducati Sebring 350 · Restoration started {PROJECT_STARTED}</p>
		<p class="text-xs text-stone-400">
			<a href="https://marcsherwood.com/garage/" class="hover:text-[var(--ducati-red)] transition-colors">Back to the garage</a>
			<span class="mx-2">·</span>
			<a href="https://marcsherwood.com" class="hover:text-[var(--ducati-red)] transition-colors">marcsherwood.com</a>
		</p>
	</div>
</footer>
