---
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/inventory', label: 'Inventory' },
	{ href: '/updates', label: 'Updates' },
	{ href: '/reference', label: 'Reference' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-[var(--workshop-cream)]/90 backdrop-blur-md border-b border-stone-200">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
		<a href="/" class="group flex items-baseline gap-2">
			<span class="font-display text-3xl tracking-wide text-[var(--charcoal)] group-hover:text-[var(--ducati-red)] transition-colors">SEBRING</span>
			<span class="font-mono text-xs text-stone-500 uppercase tracking-widest hidden sm:inline">1965 · 350</span>
		</a>
		<nav class="flex items-center gap-1 sm:gap-2">
			{
				navItems.map((item) => {
					const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
					return (
						<a
							href={item.href}
							class:list={[
								'px-3 py-1.5 text-sm font-medium rounded transition-colors',
								isActive
									? 'text-[var(--ducati-red)] bg-red-50'
									: 'text-stone-600 hover:text-[var(--charcoal)] hover:bg-stone-100',
							]}
						>
							{item.label}
						</a>
					);
				})
			}
			<a
				href="/admin"
				class="ml-2 px-3 py-1.5 text-xs font-mono uppercase tracking-wider text-stone-500 border border-stone-300 rounded hover:border-[var(--ducati-red)] hover:text-[var(--ducati-red)] transition-colors"
			>
				Admin
			</a>
		</nav>
	</div>
</header>
