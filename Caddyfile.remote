#HONEOSS CADDYFILE LETSENCRYPT AND CF DNS

http://192.168.0.62 {
    root * /var/www/analyst-pro
    route {
        try_files {path} /index.html
        file_server
    }
}

marc.honeos.ai {
    encode gzip zstd

    @static {
        file
        path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.gif
    }
    header @static Cache-Control "public, max-age=31536000, must-revalidate"

    root * /var/www/marc.honeos.ai
    route {
        try_files {path} /index.html
        file_server
    }
}

battery.fuzzynacho.org {
    reverse_proxy 192.168.0.118:8010
}

team.proservability.com {
    reverse_proxy 192.168.0.67:80
}

honeos.ai {
    redir https://www.honeos.ai{uri} 308
}

fuzzynacho.org {
    redir https://www.fuzzynacho.org{uri} 308
}

www.fuzzynacho.org {
    handle_path /blog* {
        root * /var/www/blog
        file_server
    }
    handle /dementia.html {
        root * /var/www/fuzzynacho.org
        file_server
    }
    reverse_proxy localhost:3000
}

www.marcsherwood.com {
    route {
        @crawlerFiles path /robots.txt /llms.txt /rss.xml /sitemap.xml /sitemap-index.xml /sitemap-0.xml
        handle @crawlerFiles {
            root * /var/www/marcsherwood.com
            file_server
        }
        redir https://marcsherwood.com{uri} 308
    }
}

marcsherwood.com {
    root * /var/www/marcsherwood.com
    encode gzip zstd

    @staticXml path *.xml
    handle @staticXml {
        file_server
    }

    file_server
    try_files {path} {path}/index.html /404.html
}

sebring.marcsherwood.com {
    root * /var/www/sebring.marcsherwood.com
    encode gzip zstd

    @staticXml path *.xml
    handle @staticXml {
        file_server
    }

    file_server
    try_files {path} {path}/index.html /404.html

    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
}

www.honeos.ai {
    redir /privacy /privacy.html 308
    redir /privacy/ /privacy.html 308
    redir /terms /tos.html 308
    redir /terms/ /tos.html 308
    redir /tos /tos.html 308
    redir /tos/ /tos.html 308

    @html path *.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    root * /var/www/analyst-pro
    route {
        try_files {path} {path}.html /index.html
        file_server
    }
}

honeoss.com {
    redir https://www.honeos.ai{uri} 308
}

www.honeoss.com {
    redir https://www.honeos.ai{uri} 308
}

dir.fuzzynacho.org {
    root * /var/www/dir.fuzzynacho.org
    file_server
}
